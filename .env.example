PORT=8787
# Mot de passe du tableau de bord (obligatoire en prod)
GARDECLIC_DASHBOARD_KEY=change-moi

# Fenêtre et seuil des règles (lisibles, pas une boîte noire)
GARDECLIC_WINDOW_HOURS=24
GARDECLIC_REPEAT_LIMIT=4
# Même IP flaggée sur N de tes sites → exclusion réseau
GARDECLIC_NETWORK_SITES=2

# Conservation des hits (jours)
GARDECLIC_RETENTION_DAYS=30

# Alerte admin (un mail par nouvelle IP, pas à chaque clic)
# GARDECLIC_ALERT_EMAIL=toi@exemple.fr
# GARDECLIC_ALERT_FROM=GardeClic <onboarding@resend.dev>
# RESEND_API_KEY=
# Ou un webhook (Slack / Make / n8n) :
# GARDECLIC_WEBHOOK_URL=

# Optionnel : pousser les IP vers Google Ads (sinon export CSV seulement)
# GOOGLE_ADS_DEVELOPER_TOKEN=
# GOOGLE_ADS_ACCESS_TOKEN=
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=
