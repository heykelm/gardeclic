PORT=8787
# Dashboard password (required in production)
GARDECLIC_DASHBOARD_KEY=change-me
# Public URL of this collector (snippet + MCP diagnose)
# GARDECLIC_PUBLIC_ORIGIN=https://gardeclic.vercel.app

# Vercel: durable store (KV / Upstash). Without this, serverless disk is wiped.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# GARDECLIC_EXTRA_CIDRS=198.51.100.0/24

# Rule windows (readable, not a black box)
GARDECLIC_WINDOW_HOURS=24
GARDECLIC_REPEAT_LIMIT=4
# Same IP flagged on N of your sites → network exclusion
GARDECLIC_NETWORK_SITES=2
GARDECLIC_BURST_LIMIT=3
GARDECLIC_BURST_SECONDS=120
GARDECLIC_UA_CHURN=4

# Extra signals — set to 0 to disable one
GARDECLIC_HOSTING=1
GARDECLIC_BOT_UA=1
GARDECLIC_CLICK_ID_REUSE=1
GARDECLIC_BURST=1
GARDECLIC_UA_CHURN_ON=1

# Hit retention (days)
GARDECLIC_RETENTION_DAYS=30

# Admin alert (one mail per new IP, not every later click)
# GARDECLIC_ALERT_EMAIL=you@example.com
# GARDECLIC_ALERT_FROM=GardeClic <onboarding@resend.dev>
# RESEND_API_KEY=
# Or a webhook (Slack / Make / n8n):
# GARDECLIC_WEBHOOK_URL=

# Optional: push IPs to Google Ads (otherwise CSV export only)
# GOOGLE_ADS_DEVELOPER_TOKEN=
# GOOGLE_ADS_ACCESS_TOKEN=
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=
