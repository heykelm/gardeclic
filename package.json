{
  "name": "gardeclic",
  "version": "0.2.0",
  "private": false,
  "license": "MIT",
  "description": "Self-hosted Google Ads click guard with an MCP installer. Named rules, multi-site, IP exclusions.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "gardeclic": "./src/cli.mjs"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "mcp": "node src/mcp.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "files": [
    "src",
    "sites.example.json",
    ".env.example",
    "hosting.cidrs.example",
    "mcp.example.json",
    "README.md",
    "LICENSE",
    "Dockerfile",
    "Procfile",
    "fly.toml"
  ]
}
